# Imou Open Platform credentials — see https://open.imoulife.com/book/readme/create.html
APP_NAME=your-app-name
APP_ID=your_app_id
APP_SECRET=your_app_secret

# Data center the app was registered in: sg (Singapore/East Asia), fk (Frankfurt/Central Europe), or (Oregon/Western America)
DATA_CENTER=or

# Optional: per-camera local RTSP credentials, only needed for `watch`'s local
# clip recording (bypasses the cloud entirely). <NAME> is the channel name
# from `imou devices`, upper-cased. SECURE is the camera's local RTSP/ONVIF
# password — usually shown as a "Security Code" in the Imou Life app under
# the device's info/QR screen, not your cloud account password.
# CAM_FRONTDOOR_IP="192.168.1.100"
# CAM_FRONTDOOR_SECURE=your_rtsp_password

# Optional: upload recorded clips to Google Drive (in addition to local
# disk — the local .mp4 is deleted only after a successful upload, so it
# stays as a fallback if the upload fails). Requires a Google Cloud OAuth
# client of type "TVs and Limited Input devices" (Cloud Console ->
# APIs & Services -> Credentials -> Create Credentials -> OAuth client ID;
# a service account does NOT work here — Google rejects service-account
# writes into a personal "My Drive" folder with storageQuotaExceeded).
# After setting these, run `imou gdrive-login` once (device-code flow, no
# browser needed on this machine) to authorize and cache a refresh token.
# GDRIVE_CLIENT_ID=your_client_id.apps.googleusercontent.com
# GDRIVE_CLIENT_SECRET=your_client_secret
# GDRIVE_FOLDER_ID=optional_target_folder_id_from_drive_url

# Optional: publish each motion event (the same JSON already written to
# motion_events.jsonl) to an MQTT broker — one topic per camera:
# {MQTT_TOPIC_PREFIX}/<channel_name>/motion (default prefix "imou"), so a
# downstream consumer (Home Assistant, Node-RED, ...) can subscribe once to
# the wildcard "imou/+/motion" for every bound camera. Fire-and-forget: a
# slow or unreachable broker never blocks `watch`/`listen` — that event's
# MQTT publish is just delayed or dropped, local event logging and clip
# recording are unaffected either way.
# MQTT_BROKER_HOST=192.168.1.50
# MQTT_BROKER_PORT=1883
# MQTT_USERNAME=optional_broker_username
# MQTT_PASSWORD=optional_broker_password
# MQTT_TLS=false
# MQTT_TOPIC_PREFIX=imou
# MQTT_CLIENT_ID=optional_fixed_client_id (default: a random id per run)

# Copy to ~/imou-cli/.env on the deployment host and fill in real values.
# Never commit the real file — same rules as the repo's own .env.example.

APP_NAME=your-app-name
APP_ID=your_app_id
APP_SECRET=your_app_secret

# Data center the app was registered in: sg (Singapore/East Asia), fk (Frankfurt/Central Europe), or (Oregon/Western America)
DATA_CENTER=or

# Without this, the container defaults to UTC regardless of the host's own
# timezone (verified live on a real deploy) — every "local"-named file
# (ring buffer/continuous segments, clips, snapshots) would silently end up
# UTC-timestamped instead. Set to your deployment host's real IANA zone.
TZ=Europe/Rome

# Per-camera local RTSP credentials — required for local clip recording to
# work for a given channel (channels without a pair here still get motion
# logged, just not recorded). <NAME> is the channel name from `imou devices`,
# upper-cased. SECURE is the camera's local RTSP/ONVIF password (the Imou
# Life app's "Security Code", under the device's info/QR screen — not the
# cloud account password).
CAM_FRONTDOOR_IP="192.168.1.100"
CAM_FRONTDOOR_SECURE=your_rtsp_password

CAM_BACKYARD_IP="192.168.1.101"
CAM_BACKYARD_SECURE=your_rtsp_password

# Optional: a camera with no Imou device/channel behind it at all (a plain
# LAN RTSP camera unrelated to the Imou account) — covered by continuous
# recording only, never motion detection/clip extraction/Drive/MQTT/AI
# (those all key off an Imou alarm, which this kind of camera can never
# produce). CAM_<NAME>_URL is the full RTSP URL, used as-is (no credentials
# injected — set them in the URL yourself if the stream needs auth). <NAME>
# must also be listed in EXTRA_CONTINUOUS_CHANNELS (comma-separated) — plain
# CAM_<NAME>_IP/_SECURE cameras above don't need this, they're discovered
# automatically via `imou devices`.
# CAM_SHED_URL=rtsp://192.168.1.102/ch0_0.h264
# EXTRA_CONTINUOUS_CHANNELS=shed

# Optional: only relevant with `--continuous-mode grid` in the `command:`
# block below (see CLAUDE.md's "Grid continuous recording" section). Which
# camera occupies which corner of the composed 2x2 grid video, as
# top-left,top-right,bottom-left,bottom-right (comma-separated channel
# names) — falls back to an alphabetically-sorted default if unset.
# GRID_ORDER=frontdoor,backyard,shed,ingresso

# Optional: upload recorded clips to Google Drive (in addition to local
# disk — the local .mp4 is deleted only after a successful upload, so it
# stays as a fallback if the upload fails). Requires a Google Cloud OAuth
# client of type "TVs and Limited Input devices" (a service account does
# NOT work here — see CLAUDE.md). After setting these, run
# `docker compose run --rm imou-cli gdrive-login` once to authorize and
# cache a refresh token (bind-mounted below so it survives redeploys).
GDRIVE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GDRIVE_CLIENT_SECRET=your_client_secret
GDRIVE_FOLDER_ID=your_target_folder_id_from_drive_url

# Optional: publish each motion event to an MQTT broker. See CLAUDE.md /
# the root .env.example for the full variable list and topic convention.
# MQTT_BROKER_HOST=192.168.1.50
# MQTT_BROKER_PORT=1883

# Optional: analyze each extracted clip's content (human/animal/vehicle/...)
# via the `imou-ollama` sidecar already defined in docker-compose.yaml —
# see deploy/README.md's "local AI video analysis" step for the one-time
# `ollama pull` needed before this actually does anything.
# AI_OLLAMA_URL=http://imou-ollama:11434
# AI_MODEL_NAME=moondream
